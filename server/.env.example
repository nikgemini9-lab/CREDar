# --- Rettiwt (unofficial X/Twitter search) ---
# Base64-encoded cookie string: btoa("auth_token=...;ct0=...;twid=...;")
# Extracted from a logged-in x.com session. Leave blank to run in DEMO_MODE
# with synthetic tweets so you can try the dashboard/alerts without it.
RETTIWT_API_KEY=

# Force demo mode on/off. Defaults to true when RETTIWT_API_KEY is empty.
# DEMO_MODE=false

# --- What CREDAR tracks ---
# Comma-separated list of terms combined with OR. Defaults to:
# $CRED, @crediblefin, CREDBHvVqREBCAxMihzr8D1nepHMr2gmQoZWpmgGmeta
# SEARCH_TERMS=$CRED,@crediblefin,CREDBHvVqREBCAxMihzr8D1nepHMr2gmQoZWpmgGmeta
# CASHTAG=$CRED
# HANDLE=@crediblefin
# CONTRACT_ADDRESS=CREDBHvVqREBCAxMihzr8D1nepHMr2gmQoZWpmgGmeta

# How often (ms) to poll for new tweets.
POLL_INTERVAL_MS=30000

# On the very first run (no stored cursor yet), CREDAR backfills mentions
# from this many days ago instead of only catching tweets from here on.
# X/Twitter's search only goes back ~7 days regardless of this setting.
BACKFILL_DAYS=7

# --- Telegram alerts ---
# Create a bot via @BotFather, then message it (or add it to a group) and
# fetch https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Helius (on-chain "big buy" detection, via webhook) ---
# A secret string you invent yourself and set as the "Auth Header" when
# creating the Helius webhook (see README) - Helius echoes it back on every
# delivery so this endpoint can verify requests are genuinely from Helius.
# Leave blank to run big-buy detection in CHAIN_DEMO_MODE with synthetic swaps.
HELIUS_WEBHOOK_AUTH_HEADER=

# Force chain demo mode on/off. Defaults to true when
# HELIUS_WEBHOOK_AUTH_HEADER is empty.
# CHAIN_DEMO_MODE=false

# A buy at/above this USD value triggers an alert + shows on the dashboard.
# USD value is only computed when the swap's other side is SOL/USDC/USDT.
BIG_BUY_MIN_USD=500

# Fallback threshold (in raw $CRED tokens) for buys where the counter asset
# isn't a priceable reference asset. 0 disables this fallback (recommended
# unless you know a sensible token-amount threshold for this market cap).
# BIG_BUY_MIN_TOKENS=0

# --- Sentiment analysis (optional) ---
# Classifies each real (non-demo) tweet as bullish/positive/negative/fud using
# the Claude API (Haiku 4.5 - cheap and fast, roughly $0.0004-0.0005 per
# tweet). Runs as a background sweep so it never slows down ingestion or
# backfill. Leave blank to disable sentiment entirely (chart/badges hide).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Database ---
# Defaults to a local SQLite file at ./data/credar.db - fine for local dev,
# but it won't survive redeploys on hosts with an ephemeral filesystem (like
# Render's free plan). For storage that persists, create a free database at
# https://turso.tech, then set:
# DATABASE_URL=libsql://<your-db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=<token from `turso db tokens create <your-db>`>
# DATABASE_URL=file:./data/credar.db
# DATABASE_AUTH_TOKEN=

# --- Admin ---
# A secret you invent yourself (e.g. `openssl rand -hex 16`). Lets you visit
# https://<your-service>/api/admin/reset-tweet-cursor?token=<this value>
# in a browser to force the next poll to re-run the 7-day backfill (useful
# if a cursor got set before you had this feature, or before real
# credentials were configured). Leave blank to disable the endpoint.
ADMIN_TOKEN=

# --- Server ---
PORT=8787
CORS_ORIGIN=*
