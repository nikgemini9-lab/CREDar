# --- Rettiwt (unofficial X/Twitter search) ---
# Base64-encoded cookie string: btoa("auth_token=...;ct0=...;twid=...;")
# Extracted from a logged-in x.com session. Leave blank to run in DEMO_MODE
# with synthetic tweets so you can try the dashboard/alerts without it.
RETTIWT_API_KEY=

# Force demo mode on/off. Defaults to true when RETTIWT_API_KEY is empty.
# DEMO_MODE=false

# --- What CREDAR tracks ---
# Comma-separated list of terms combined with OR. Defaults to:
# $CRED, @crediblefin, CREDBHvVqREBCAxMihzr8D1nepHMr2gmQoZWpmgGmeta
# SEARCH_TERMS=$CRED,@crediblefin,CREDBHvVqREBCAxMihzr8D1nepHMr2gmQoZWpmgGmeta
# CASHTAG=$CRED
# HANDLE=@crediblefin
# CONTRACT_ADDRESS=CREDBHvVqREBCAxMihzr8D1nepHMr2gmQoZWpmgGmeta

# How often (ms) to poll for new tweets.
POLL_INTERVAL_MS=30000

# --- Telegram alerts ---
# Create a bot via @BotFather, then message it (or add it to a group) and
# fetch https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database ---
# Defaults to a local SQLite file at ./data/credar.db - fine for local dev,
# but it won't survive redeploys on hosts with an ephemeral filesystem (like
# Render's free plan). For storage that persists, create a free database at
# https://turso.tech, then set:
# DATABASE_URL=libsql://<your-db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=<token from `turso db tokens create <your-db>`>
# DATABASE_URL=file:./data/credar.db
# DATABASE_AUTH_TOKEN=

# --- Server ---
PORT=8787
CORS_ORIGIN=*
